{
  "name": "ui-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "bunx turbo run build --filter='swift-rust...'",
    "dev": "bun ../../packages/swift-rust/bin/dev-server.mjs --port 3211",
    "build": "bun ../../packages/swift-rust/bin/build.mjs",
